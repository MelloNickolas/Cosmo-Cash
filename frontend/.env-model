# Modelo das variáveis do front. Copie para ".env.local" (ignorado pelo Git) e ajuste.
# ATENÇÃO: variáveis VITE_ entram no BUILD e ficam visíveis no navegador. Nunca coloque segredos aqui.
# Mudou uma variável? É preciso gerar o build/deploy de novo.

# URL da API (backend), sem barra no final.
VITE_API_URL=http://localhost:5136

# Nome da loja do cliente: aparece no cabeçalho, no login e no nome do app instalado (PWA).
VITE_NOME_LOJA=Cosmo Cash
