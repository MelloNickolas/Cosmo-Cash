# Modelo das variáveis de ambiente do backend.
# Copie para ".env" (ignorado pelo Git) e preencha. NUNCA versionar o .env.
# Em produção, essas variáveis são configuradas no painel do host (MonsterASP), não em arquivo.

# Postgres do Neon: aceita a URI "postgresql://..." copiada do painel.
CONNECTION_STRING=

# Chave que assina os tokens. Mínimo 32 caracteres, aleatória e DIFERENTE por cliente.
# Gerar: openssl rand -base64 48
JWT_KEY=

# Origens permitidas do front, separadas por vírgula (sem barra no final).
CORS_ORIGINS=http://localhost:5173

# Primeiro usuário (AdminTotal). Só é criado se ainda não existir nenhum AdminTotal.
# Senha: de 8 a 72 caracteres.
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=
